# ScamEye – example settings. This file is safe to share: it has NO real key.
#
# For local testing:
#   1. Make a copy of this file named  .env.local
#   2. Put your real key in .env.local (never in this file!)
#   .env.local is in .gitignore, so it never goes to GitHub.
#
# On Vercel: add these under Project → Settings → Environment Variables instead.

GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
